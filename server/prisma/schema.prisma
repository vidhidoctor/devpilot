generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Repository {
  id        Int      @id @default(autoincrement())
  provider  String
  owner     String
  name      String
  fullName  String   @unique

  pullRequests PullRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PullRequest {
  id          Int      @id @default(autoincrement())
  number      Int
  title       String
  description String?
  author      String
  baseBranch  String
  headBranch  String
  commitSha   String
  status      String

  repositoryId Int
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  changedFiles ChangedFile[]
  analyses     Analysis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, number])
}

model ChangedFile {
  id         Int     @id @default(autoincrement())
  filename   String
  status     String
  additions  Int
  deletions  Int
  changes    Int
  patch      String?

  pullRequestId Int
  pullRequest   PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  findings Finding[]

  createdAt DateTime @default(now())
}

model Analysis {
  id            Int      @id @default(autoincrement())
  status        String
  summary       String?

  pullRequestId Int
  pullRequest   PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  findings Finding[]

  createdAt   DateTime @default(now())
  completedAt DateTime?
}

model Finding {
  id         Int     @id @default(autoincrement())
  severity   String
  category   String?
  title      String
  message    String
  suggestion String?
  lineNumber Int?

  analysisId Int
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  changedFileId Int?
  changedFile   ChangedFile? @relation(fields: [changedFileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}